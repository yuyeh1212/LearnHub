# Local PostgreSQL connection used by the API service.
# On Vercel, use Supabase's Transaction pooler URL (port 6543) instead.
# Do not commit a real password or production connection string.
DATABASE_URL="postgresql://learnhub:change-me@127.0.0.1:5432/learnhub?schema=public"

# Use a randomly generated value with at least 32 characters in local development.
JWT_SECRET="replace-with-a-long-random-local-development-secret"

# Optional cross-origin frontend permitted to call the API.
# Omit this on a same-origin Vercel deployment.
CORS_ORIGIN="http://127.0.0.1:4173"

# Public browser setting only; use /api/v1 for a same-origin Vercel deployment.
# Never put tokens or credentials in VITE_ variables.
VITE_API_BASE_URL="http://127.0.0.1:3001/api/v1"

# Public base URL used only by the local content-storage driver.
# It can be omitted when production uses Supabase Storage.
PUBLIC_API_BASE_URL="http://127.0.0.1:3001/api/v1"

# Private content stays outside the frontend bundle and is served only through signed links.
CONTENT_STORAGE_ROOT="storage/private"
CONTENT_ACCESS_TTL_SECONDS="900"
CONTENT_STORAGE_DRIVER="local"

# Optional in local development; production should use a separate random secret.
CONTENT_SIGNING_SECRET="replace-with-a-separate-long-random-content-secret"

# Use these server-only settings when CONTENT_STORAGE_DRIVER="supabase".
# Production deployments must not expose SUPABASE_SECRET_KEY through a VITE_ variable.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace-with-a-server-only-key"
SUPABASE_STORAGE_BUCKET="learnhub-content"
